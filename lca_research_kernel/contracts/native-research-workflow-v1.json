{
  "contract": "lca_research_kernel.native_research_workflow/v1",
  "workflow_id": "d18-tiangong-native-research-v1",
  "selection_basis": "accepted_state_and_expected_state_change",
  "truth_source": "project_record",
  "candidate_sources": [
    "model",
    "skill",
    "mcp",
    "capability"
  ],
  "states": [
    "engagement_frozen",
    "goal_and_scope_bounded",
    "data_classified_and_gaps_explicit",
    "architecture_decision_framed",
    "candidate_execution_completed",
    "candidate_integrated",
    "domain_and_permission_assessed",
    "candidate_outcome_or_bounded_limitation"
  ],
  "transitions": [
    {
      "transition_id": "bound-goal-and-scope",
      "from_state": "engagement_frozen",
      "to_state": "goal_and_scope_bounded",
      "owner": "product_interface",
      "required_evidence_role": "engagement",
      "expected_delta": "accepted goal, scope and source boundary become explicit"
    },
    {
      "transition_id": "classify-data-and-gaps",
      "from_state": "goal_and_scope_bounded",
      "to_state": "data_classified_and_gaps_explicit",
      "owner": "lca_domain_kernel",
      "required_evidence_role": "goal_scope",
      "expected_delta": "accepted, candidate, assumption and missing data are separated"
    },
    {
      "transition_id": "frame-architecture-decision",
      "from_state": "data_classified_and_gaps_explicit",
      "to_state": "architecture_decision_framed",
      "owner": "research_orchestrator",
      "required_evidence_role": "data_gap_classification",
      "expected_delta": "one state-changing activity and bounded alternatives are explicit"
    },
    {
      "transition_id": "execute-authorized-candidate-activity",
      "from_state": "architecture_decision_framed",
      "to_state": "candidate_execution_completed",
      "owner": "research_orchestrator",
      "required_evidence_role": "authorized_decision_frame",
      "expected_delta": "a source-bound candidate or typed failure exists"
    },
    {
      "transition_id": "integrate-candidate",
      "from_state": "candidate_execution_completed",
      "to_state": "candidate_integrated",
      "owner": "research_orchestrator",
      "required_evidence_role": "candidate_execution_receipt",
      "expected_delta": "candidate lineage and limitations are integrated without truth promotion"
    },
    {
      "transition_id": "assess-domain-and-permission",
      "from_state": "candidate_integrated",
      "to_state": "domain_and_permission_assessed",
      "owner": "assurance_boundary",
      "required_evidence_role": "integrated_candidate",
      "expected_delta": "scientific, authority and permission gates have explicit decisions"
    },
    {
      "transition_id": "bound-outcome",
      "from_state": "domain_and_permission_assessed",
      "to_state": "candidate_outcome_or_bounded_limitation",
      "owner": "assurance_boundary",
      "required_evidence_role": "domain_permission_assessment",
      "expected_delta": "a candidate outcome or an evidence-bounded limitation is reviewable"
    }
  ],
  "invariants": {
    "accepted_write_requires_assurance": true,
    "candidate_is_not_fact": true,
    "official_identity_is_tiangong_owned": true,
    "external_effect_requires_human_responsibility": true,
    "route_selection_by_state_only": true,
    "scientific_result_not_required_for_runtime_probe": true
  }
}
