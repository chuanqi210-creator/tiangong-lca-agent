  "output_classifications": ["candidate_only", "computed", "missing"],
  "outcomes": ["complete_candidate", "bounded", "failed"],
  "acceptance_checks": ["functional_equivalence_is_explicit", "scope_and_method_are_aligned", "uncertainty_cannot_reverse_unqualified_claim", "claim_ceiling_is_observed"],
  "failure_boundaries": ["functional_equivalence_absent", "incompatible_method_or_boundary", "material_uncertainty_unresolved"],
