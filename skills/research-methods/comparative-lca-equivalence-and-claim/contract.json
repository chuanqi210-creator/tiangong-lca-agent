    "requirements": ["comparison"],
    "conflict_types": ["comparison_basis_conflict", "functional_equivalence_conflict", "method_conflict"],
    "target_object_kinds": ["FunctionalUnit", "SystemBoundary", "ProductSystem", "LCIAMethod", "Result"]
  },
  "required_inputs": ["two_or_more_accepted_result_refs", "intended_use", "equivalence_dimensions"],
  "expected_artifact": "comparative_claim_assessment",
  "accepted_state_delta": "comparison_equivalence_proven_or_claim_blocked",
