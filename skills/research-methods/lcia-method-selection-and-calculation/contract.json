  "failure_boundaries": ["compatible_method_absent", "calculation_runtime_unavailable", "characterization_gap_material"],
  "forbidden": ["direct_project_record_write", "model_generated_numeric_lcia", "uncharacterized_as_zero", "cross_version_category_merge"],
